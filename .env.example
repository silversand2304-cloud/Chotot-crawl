# Sao chép thành .env rồi điền. KHÔNG đưa .env lên GitHub.

# --- Telegram (bỏ trống thì cảnh báo chỉ in ra màn hình) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Mật khẩu dashboard: BẮT BUỘC đặt khi chạy trên VPS ---
DASH_USER=
DASH_PASS=

# --- Nhịp quét (giây). Khuyến nghị >= 120 khi chạy thật ---
POLL_SECONDS=120
# BASELINE_PAGES=3

# --- Ngưỡng cảnh báo (tỷ lệ rẻ hơn trung vị) ---
# DEAL_PCT=0.15
# DEAL_Z=2.0
# SCAM_PCT=0.40

# --- Đo tốc độ bán: kiểm tra lại tin cũ còn đăng hay đã gỡ (1 request/tin) ---
# TRACK_PER_CYCLE=3
# TRACK_INTERVAL_HOURS=6
# TRACK_DAYS=21

# --- Tình trạng máy ---
# Quy đổi giá theo pin/ngoại hình trước khi so (1 = bật, 0 = tắt)
# USE_CONDITION=1
# Lựa chọn của người mua: không báo deal nếu người bán ghi pin / ngoại hình thấp hơn mức này (0 = tắt)
# ALERT_MIN_BATTERY=80
# ALERT_MIN_COSMETIC=93

# --- Nâng cao ---
# DEAL_DB=/opt/deal-finder/data/deals.db
# SKIP_KEEP_DAYS=30
# WATCHLIST=/opt/deal-finder/watchlist.json
# EXPORT_DIR=/opt/deal-finder/exports
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
# Trỏ collector vào máy chủ mock để test (bỏ trống = Chợ Tốt thật):
# CHOTOT_GATEWAY=http://127.0.0.1:8900
